{
    "name": "samosadlaker/statamic-langtag",
    "description": "Statamic LangTag addon",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "laravel",
        "localization",
        "i18n",
        "multilingual"
    ],
    "authors": [
        {
            "name": "Samosadlaker",
            "email": "dev@samosadlaker.eu"
        }
    ],
    "homepage": "https://github.com/SamoSadlaker/statamic-langtag",
    "support": {
        "issues": "https://github.com/SamoSadlaker/statamic-langtag/issues",
        "source": "https://github.com/SamoSadlaker/statamic-langtag"
    },
    "autoload": {
        "psr-4": {
            "SamoSadlaker\\StatamicLangtag\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SamoSadlaker\\StatamicLangtag\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.1",
        "statamic/cms": "^5.0 | ^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 | ^10.0 | ^11.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        },
        "non-feature-branches": ["master", "develop"]
    },
    "extra": {
        "statamic": {
            "name": "Statamic Langtag",
            "description": "Statamic Langtag addon",
            "developer": "Samosadlaker",
            "developer-url": "https://samosadlaker.eu",
            "url": "https://github.com/SamoSadlaker/statamic-langtag"
        },
        "laravel": {
            "providers": [
                "SamoSadlaker\\StatamicLangtag\\ServiceProvider"
            ]
        }
    }
}
